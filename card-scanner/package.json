{
  "name": "card-scanner",
  "private": true,
  "version": "0.1.0",
  "description": "Free trading card scanner and collection tracker (Pokémon, One Piece, Magic: The Gathering, Marvel, Yu-Gi-Oh!, Lorcana).",
  "type": "module",
  "scripts": {
    "dev": "npm run ocr-assets && vite",
    "build": "npm run ocr-assets && tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && node scripts/build-single.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "desktop": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder --publish never",
    "ios": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@tesseract.js-data/eng": "1.0.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "main": "desktop/main.js",
  "author": "Card Scanner",
  "homepage": "https://github.com/petermayfieldlogistics-oss/jarvis",
  "build": {
    "appId": "io.github.petermayfieldlogistics.cardscanner",
    "productName": "Card Scanner",
    "artifactName": "Card-Scanner-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "icon": "public/icon-512.png",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Card Scanner uses the camera to read your trading cards."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petermayfieldlogistics-oss/jarvis.git",
    "directory": "card-scanner"
  }
}
